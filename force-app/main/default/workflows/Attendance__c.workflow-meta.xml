<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Approval_Limit_Exceeded_for_This_Month</fullName>
        <description>Approval Limit Exceeded for This Month</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Attendance_Limit_Exceeded_Notification</template>
    </alerts>
    <alerts>
        <fullName>Approval_submission_mail</fullName>
        <description>Approval submission mail</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Approval_Submission_mail</template>
    </alerts>
    <alerts>
        <fullName>Attendance_Approval_Mail</fullName>
        <description>Attendance Approval Mail</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Approval_Approved</template>
    </alerts>
    <alerts>
        <fullName>Attendance_Reject_Notification</fullName>
        <description>Attendance Reject Notification</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Attendance_Rejection_Notification</template>
    </alerts>
    <fieldUpdates>
        <fullName>Approval_Approved</fullName>
        <description>Approval is approved by the manager</description>
        <field>Approval_Status__c</field>
        <literalValue>Approved</literalValue>
        <name>Approval Approved</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Approval_Pending</fullName>
        <description>When the approval is submitted</description>
        <field>Approval_Status__c</field>
        <literalValue>Pending</literalValue>
        <name>Approval Pending</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Approval_Rejected</fullName>
        <description>Approval is being rejected by the manager</description>
        <field>Approval_Status__c</field>
        <literalValue>Rejected</literalValue>
        <name>Approval Rejected</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>Status_Update</fullName>
        <description>Update the status to present on the approval from the manager</description>
        <field>Status__c</field>
        <literalValue>Present</literalValue>
        <name>Status Update</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
        <reevaluateOnChange>false</reevaluateOnChange>
    </fieldUpdates>
</Workflow>
