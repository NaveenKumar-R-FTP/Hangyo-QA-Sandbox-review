<apex:page controller="InvoicePDFWrapperController" showHeader="false" sidebar="false">
    <apex:outputPanel rendered="{!shouldRedirect}">
        <!--script>
            alert('You need to confirm the invoice before downloading.');
            window.location.href = '{!redirectUrl}';
        </script-->
        <html>
        <head>
            <script>
                window.onload = function () {
                    alert('Please confirm the invoice before downloading.');

                    // Redirect original tab (the opener)
                    if (window.opener && !window.opener.closed) {
                        try {
                            window.opener.location.href = '{!redirectUrl}';
                        } catch (e) {
                            console.error('Failed to redirect opener:', e);
                        }
                    }

                    // Close this tab (the error one)
                    window.close();
                };
            </script>
        </head>
        <body></body>
        </html>
    </apex:outputPanel>

    <apex:outputPanel rendered="{!NOT(shouldRedirect)}">
        <html>
        <head>
            <meta charset="UTF-8"/>
            <title>{!invoiceName}</title>
            <style>
                html, body {
                    margin: 0;
                    padding: 0;
                    height: 100%;
                    width: 100%;
                }

                iframe {
                    width: 100%;
                    height: 100%;
                    border: none;
                }
            </style>
            <script>
                window.onload = function () {
                    const iframe = document.querySelector('iframe');
                    if (iframe) {
                        setTimeout(() => {
                            try {
                                iframe.focus();
                                iframe.contentWindow.print();
                            } catch (e) {
                                console.error('Print failed: ', e);
                            }
                        }, 800);
                    }
                };
            </script>
        </head>
        <body>
            <iframe src="data:application/pdf;base64,{!pdfBase64}" title="{!invoiceName}"></iframe>
        </body>
        </html>
    </apex:outputPanel>
</apex:page>