<apex:page controller="CounterInvoicePdfController" standardStylesheets="false" renderAs="pdf" showHeader="false" applyBodyTag="false" applyHtmlTag="false" readOnly="true" cache="false">

<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html;charset=UTF-8"/>
        <style>
            .qrWrapper img{
                width:70px !important;
                height:70px !important;
                object-fit:contain;
            }
            @page{
                size:A4;
                margin:1mm;
                margin-top:139px;
                margin-bottom:40px;
                @top-left{ content:element(header); }
                @bottom-center{ content:element(footer); }
            }
            body{
                font-family:Tahoma;
                font-size:10pt;
                margin-left:6px;
                margin-right:12px;
            }
            table{ page-break-inside:auto; border-collapse:collapse; width:100%; }
            tr{ page-break-inside:avoid; }
            .header{
                position:running(header);
                width:98%;
                margin-left:5px;
            }
            .headerBox{
                border:1px solid black;
                padding:6px;
                margin-top:2px;
            }
            .title{ font-size:18px; font-weight:bold; text-align:center; }
            .subtitle{ font-size:11px; text-align:center; }
            .companyName{ font-size:14pt; font-weight:bold; }
            .companyBlock{ font-size:10pt; font-weight:bold; }
            .maintable td,.maintable th{
                border:1px solid black;
                padding:2px;
                font-size:8pt;
            }
            .headerRow th{
                font-size:8pt;
                font-weight:bold;
                background:#d9d9d9;
            }
            .totalRow td{ font-weight:bold; }
            .termsTitle{ font-size:7pt; font-weight:bold; }
            .sign{ font-size:8pt; font-weight:bold; }
            .signNote{ font-size:8pt; }
            #footer{
                position:running(footer);
                text-align:center;
                font-size:10px;
            }
            .page-number:before{
                content:"Page " counter(page) " of " counter(pages);
            }
            body, table, td, th, tr, div, span {
                font-family: Tahoma !important;
            }
            .invoiceBody,
            .invoiceBody table,
            .invoiceBody td,
            .invoiceBody th,
            .invoiceBody div,
            .invoiceBody span {
                font-size: 9pt !important;
            }
        </style>
    </head>

<body>

<!-- ================= HEADER ================= -->
<div class="header">
    <div class="headerBox">
        <table width="100%" style="border-collapse:collapse; height:100%;">
            <tr style="height:90%;">
                <td width="15%" valign="top" style="text-align:left;">
                    <img src="{!dmsUserInfo.MediumPhotoUrl}" width="80" height="80"/>
                </td>
                <td width="70%" valign="top" style="text-align:center;">
                    <div class="title">Tax Invoice</div>
                    <div class="subtitle">(Original For Recipient)</div>
                    <div class="companyName">{!dmsUserInfo.Contact.Account.Name}</div>
                    <div class="companyBlock">
                        {!dmsUserInfo.Contact.Account.BillingStreet},
                        {!dmsUserInfo.Contact.Account.BillingCity},
                        {!dmsUserInfo.Contact.Account.BillingState},
                        {!dmsUserInfo.Contact.Account.BillingPostalCode},
                        {!dmsUserInfo.Contact.Account.BillingCountry}
                    </div>
                </td>
                <td width="15%" valign="top" style="text-align:right;">
                    <div class="qrWrapper">
                        <apex:outputText escape="false" value="{!dmsUserInfo.UPI_QR_CODE__c}" />
                    </div>
                </td>
            </tr>
            <tr style="height:10%;">
                <td colspan="3" style="padding-top:5px;">
                    <table width="100%">
                        <tr>
                            <td style="text-align:left; font-weight:bold;">
                                GST No: {!dmsUserInfo.GSTIN__c}
                            </td>
                            <td style="text-align:right; font-weight:bold;">
                                Mobile No: {!dmsUserInfo.Contact.Account.Phone_1__c}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </div>
</div>

<!-- FOOTER -->
<div id="footer">
    <div class="page-number"></div>
</div>

<!-- ================= INVOICE BODY ================= -->
<div class="invoiceBody">
<apex:repeat value="{!invoiceWrappers}" var="wrapper">

<table class="maintable">

<!-- ================= BUYER + INFO ROW ================= -->
<tr>

    <!-- BUYER: Counter Invoice customer info from Order -->
    <td colspan="10" valign="top" style="font-family:Tahoma;">
        <b>Buyer Name:</b> <b>{!wrapper.invoice.Order__r.Customer_Name__c}</b><br/>
        <div style="word-wrap:break-word; white-space:normal; width:250px;">
            <b>Address: {!wrapper.invoice.Order__r.Customer_Address__c}</b>
        </div>
        <b>Ph No:</b> <b>{!wrapper.invoice.Order__r.Customer_Phone__c}</b><br/>
        <b>GST No:</b> <b>{!wrapper.invoice.Order__r.GSTIN__c}</b><br/>
        <b>Company:</b> <b>{!wrapper.invoice.Order__r.Company__c}</b>
    </td>

    <!-- SALE TYPE + SALESMAN -->
    <td colspan="6" valign="top" style="font-family:Tahoma;">
        <b>Sale Type:</b> {!wrapper.invoice.Order__r.Sale_Type__c}<br/>
        <b>Price Type:</b> {!wrapper.invoice.Order__r.Price_Type__c}<br/>
        Salesman: {!wrapper.invoice.Order__r.Ordered_By__r.Name}<br/>
        Ph: {!wrapper.invoice.Order__r.Ordered_By__r.MobilePhone}<br/>
        Credit Period: {!wrapper.invoice.Credit_Period__c}
    </td>

    <!-- INVOICE INFO -->
    <td colspan="4" valign="top" style="font-family:Tahoma;">
        FSSAI No: {!wrapper.invoice.Distributor_Account__r.FSSAI__c}<br/>
        Invoice No: {!wrapper.invoice.Invoice_Number__c}<br/>
        Invoice Date:
        <apex:outputText value="{0,date,dd-MM-yyyy}">
            <apex:param value="{!wrapper.invoice.Invoice_Date__c}"/>
        </apex:outputText>
    </td>

</tr>

<!-- ================= LINE ITEM HEADER ================= -->
<tr class="headerRow" align="center" style="font-family:Tahoma;">
    <th colspan="10">Item Description</th>
    <th>QTY</th>
    <th>MRP</th>
    <th>HSN</th>
    <th>Rate</th>
    <th>Basic Amt</th>
    <th>Discount</th>
    <th>Txble Amt</th>
    <th>Tax Amt</th>
    <th>Net Amt</th>
</tr>

<!-- ================= LINE ITEMS ================= -->
<!-- Rate/Basic Amt/Discount/Net Amt are all pre-computed in Apex on the LineItemDisplay
     wrapper (CounterInvoicePdfController.cls) rather than as VF apex:variable formulas —
     the formula-based version was blocking deploy with "Unknown property
     'CounterInvoicePdfController.displayBasicAmt'" and could not be resolved even after
     several rewrites, so the math was moved server-side where it's also unit-testable.
     For Counter Invoice + MRP, item.displayBasicAmt − item.displayDiscount reconstructs
     exactly to item.rec.Tax__c (the taxable base). Every other invoice keeps the plain,
     unextracted values (extractionFactor is 1), so nothing changes for those. -->
<apex:variable var="i" value="{!0}"/>

<apex:repeat value="{!wrapper.invoiceLineItems}" var="item">
<apex:variable var="i" value="{!i+1}"/>

<tr>
    <td colspan="10">{!i}. {!item.rec.Product__r.Name}</td>
    <td align="right">{!item.rec.Quantity__c}</td>
    <td align="right">
        <apex:outputText value="{0,number,##0}">
            <apex:param value="{!item.rec.MRP__c}"/>
        </apex:outputText>
    </td>
    <td align="right">{!$Label.Invoice_HSN}</td>
    <td align="right">
        <apex:outputText value="{0,number,0.00}">
            <apex:param value="{!item.displayRate}"/>
        </apex:outputText>
    </td>
    <td align="right">{!item.displayBasicAmt}</td>
    <td align="right">{!item.displayDiscount}</td>
    <td align="right">{!item.rec.Tax__c}</td>
    <td align="right">{!item.rec.Total_Tax__c}</td>
    <td align="right">{!item.lineNetAmt}</td>
</tr>
</apex:repeat>

<!-- ================= TOTALS ROW ================= -->
<tr class="totalRow" align="center">
    <td colspan="10" align="left">Total</td>
    <td>{!wrapper.invoice.Total_Quantity__c}</td>
    <td></td>
    <td></td>
    <td></td>
    <td>{!wrapper.totalBasicAmt}</td>
    <td>{!wrapper.totalDiscountDisplay}</td>
    <td>{!wrapper.invoice.Taxable_Amount__c}</td>
    <td>{!wrapper.invoice.Total_GST__c}</td>
    <td>{!wrapper.invoice.Invoice_Amount__c}</td>
</tr>

<!-- ================= AMOUNT + BANK + SUMMARY ================= -->
<tr>
    <td colspan="16" valign="top" style="border:1px solid black; padding:6px;">
        <b>Amount: {!wrapper.invoice.Invoice_Amount_In_Words__c}</b><br/><br/>
        <b>Invoice Amount Subject to Reverse Charge: NIL</b><br/><br/>
        <b>Payment Against Delivery:</b><br/>
        <b>(Cash/QR Scan/NEFT – Refer Bank Details Below.)</b><br/><br/>
        <b>Account Name:</b> {!dmsUserInfo.Name}<br/>
        <b>Bank Name:</b> {!dmsUserInfo.Bank_Name__c}<br/>
        <b>Bank A/c No:</b> {!dmsUserInfo.Bank_Account_Number__c}<br/>
        <b>IFSC Code:</b> {!dmsUserInfo.IFSC_Code__c}
    </td>
    <td colspan="4" valign="top" style="padding:-2px;">
        <table width="100%" style="border-collapse:collapse;">
            <tr>
                <td style="border:1px solid black; font-weight:bold;">Sub Total</td>
                <td style="border:1px solid black; text-align:right; font-weight:bold;">{!wrapper.totalBasicAmt}</td>
            </tr>
            <tr>
                <td style="border:1px solid black; font-weight:bold;">Discount</td>
                <td style="border:1px solid black; text-align:right; font-weight:bold;">{!wrapper.totalDiscountDisplay}</td>
            </tr>
            <tr>
                <td style="border:1px solid black; font-weight:bold;">Taxable Value</td>
                <td style="border:1px solid black; text-align:right; font-weight:bold;">{!wrapper.invoice.Taxable_Amount__c}</td>
            </tr>
            <tr>
                <td style="border:1px solid black; font-weight:bold;">Total GST</td>
                <td style="border:1px solid black; text-align:right; font-weight:bold;">{!wrapper.invoice.Total_GST__c}</td>
            </tr>
            <tr>
                <td style="border:1px solid black; font-weight:bold;">Round Off</td>
                <td style="border:1px solid black; text-align:right; font-weight:bold;">
                    <apex:outputText value="{0,number,##0.00}">
                        <apex:param value="{!roundOff}"/>
                    </apex:outputText>
                </td>
            </tr>
            <tr>
                <td style="border:1px solid black; font-weight:bold;">Net Amount</td>
                <td style="border:1px solid black; text-align:right; font-weight:bold;">{!wrapper.invoice.Invoice_Amount__c}</td>
            </tr>
        </table>
    </td>
</tr>

<!-- ================= HSN SUMMARY ================= -->
<tr>
    <td colspan="12" valign="top" style="padding:0px;">
        <table width="100%" style="border-collapse:collapse; table-layout:fixed; font-size:6.5pt;">
    <tr style="background:#d9d9d9; font-weight:bold;">
        <td colspan="2" align="center" style="border:1px solid black;">HSN Code</td>
        <td colspan="2" align="center" style="border:1px solid black;">Taxable Value</td>
        <td colspan="2" align="center" style="border:1px solid black;">SGST %</td>
        <td colspan="2" align="center" style="border:1px solid black;">SGST Amt</td>
        <td colspan="2" align="center" style="border:1px solid black;">CGST %</td>
        <td colspan="2" align="center" style="border:1px solid black;">CGST Amt</td>
        <td colspan="2" align="center" style="border:1px solid black;">IGST %</td>
        <td colspan="2" align="center" style="border:1px solid black;">IGST Amt</td>
    </tr>
    <tr>
        <td colspan="2" align="center" style="border:1px solid black;">{!$Label.Invoice_HSN}</td>
        <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.Taxable_Amount__c}</td>
        <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.SGST__c}</td>
        <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.SGST_Amount__c}</td>
        <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.CGST__c}</td>
        <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.CGST_Amount__c}</td>
        <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.IGST__c}</td>
        <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.IGST_Amount__c}</td>
    </tr>
    <tr style="font-weight:bold;">
        <td colspan="2" align="center" style="border:1px solid black;">Total</td>
        <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.Taxable_Amount__c}</td>
        <td colspan="4" align="center" style="border:1px solid black;">{!wrapper.invoice.SGST_Amount__c}</td>
        <td colspan="4" align="center" style="border:1px solid black;">{!wrapper.invoice.CGST_Amount__c}</td>
        <td colspan="4" align="center" style="border:1px solid black;">{!wrapper.invoice.IGST_Amount__c}</td>
    </tr>
</table>
    </td>
    <td colspan="10" style="border:1px solid black; padding:6px;">
        <apex:outputText value="{!freeOfferMessage}" rendered="{!NOT(ISBLANK(freeOfferMessage))}" style="font-weight:bold;"/>
    </td>
</tr>

<!-- ================= TERMS ================= -->
<tr>
    <td colspan="10">
        <div class="termsTitle">Terms and Conditions</div>
        {!dmsUserInfo.Terms_and_Conditions__c}
    </td>
    <td colspan="10" align="center">
        <div class="sign">For {!dmsUserInfo.Contact.Account.Name}</div>
        <div class="signNote">This is a computer generated invoice hence signature is not required</div>
    </td>
</tr>

</table>
</apex:repeat>
</div>
</body>
</html>
</apex:page>