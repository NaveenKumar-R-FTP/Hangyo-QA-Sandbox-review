            function renderPayload(data) {
                var g = window.google && window.google.maps;
                if (!g || !data) {
                    return false;
                }

                var routeFp = hangyoRoutePayloadFingerprint(data);
                var forceRouteRender = data.forceRouteRender === true;
                if (!forceRouteRender) {
                    if (
                        routeFp === hangyoLastRoutePayloadFingerprint &&
                        routeRequestGen > 0 &&
                        routeLineSettledForGen === routeRequestGen
                    ) {
                        return true;
                    }
                    if (
                        routeFp === hangyoLastRoutePayloadFingerprint &&
                        routeDirectionsInFlightGen === routeRequestGen &&
                        routeRequestGen > 0
                    ) {
                        return true;
                    }
                }
                hangyoLastRoutePayloadFingerprint = routeFp;

                var distanceOnly = data.renderMode === 'distanceOnly';
                var useDirections = data.routingMode === 'directions';
                var path = data.path || [];
                var markers = data.markers || [];
                var dc = data.defaultCenter || DEFAULT_CENTER;
                var dz = typeof data.defaultZoom === 'number' ? data.defaultZoom : DEFAULT_ZOOM;

                clearGraphics();
                ensureMap(g, dc, dz);
                if (!map) {
                    return false;
                }
                if (!distanceOnly) {
                    hangyoEnsureMapLegend(g, useDirections);
                }

                var bounds = new g.LatLngBounds();
                var hasBounds = false;

                if (!distanceOnly) {
                    var markerPrep = [];
                    for (var m = 0; markers.length > m; m++) {
                        var mk0 = markers[m];
                        var la0 = Number(mk0 && mk0.lat);
                        var ln0 = Number(mk0 && mk0.lng);
                        if (!isFinite(la0) || !isFinite(ln0)) {
                            continue;
                        }
                        markerPrep.push({
                            mk: mk0,
                            lat: la0,
                            lng: ln0
                        });
                    }
                    hangyoApplyCoincidentMarkerDisplayPositions(markerPrep);

                    var m2;
                    for (m2 = 0; markerPrep.length > m2; m2++) {
                        var row = markerPrep[m2];
                        var mk = row.mk;
                        var pos = { lat: row._dispLat, lng: row._dispLng };
                        bounds.extend(pos);
                        hasBounds = true;

                        var fillHx = colorForActivityType(
                            mk.activityType || mk.callType || mk.title
                        );

                        //The markers are marked in the Google Map
                        var marker = new g.Marker({
                            position: pos,
                            map: map,
                            title: '',
                            zIndex: 140 + m2,
                            optimized: false,
                            icon: hangyoActivityPinIcon(g, fillHx)
                        });
                        hangyoAttachMarkerHoverCard(g, marker, mk);
                        activityMarkers.push(marker);
                    }
                }

                routeRequestGen += 1;
                var routingGen = routeRequestGen;

                var routePts = hangyoPathForRouting(path);
                if (routePts.length < 2 && markers.length >= 2) {
                    var markerPathIn = [];
                    var mxi;
                    for (mxi = 0; markers.length > mxi; mxi++) {
                        var mla = Number(markers[mxi].lat);
                        var mln = Number(markers[mxi].lng);
                        if (isFinite(mla) && isFinite(mln)) {
                            markerPathIn.push({ lat: mla, lng: mln });
                        }
                    }
                    routePts = hangyoPathForRouting(markerPathIn);
                }

                if (2 > routePts.length) {
                    if (useDirections) {
                        postRoadDrivingDistanceKm(0, routingGen, routePts);
                    } else {
                        postHaversineDistanceKm(routingGen, routePts);
                    }
                    if (!distanceOnly && routePts.length >= 2) {
                        hangyoAttachStraightPolyline(g, routePts, bounds);
                    }
                } else {
                    var rp;
                    for (rp = 0; routePts.length > rp; rp++) {
                        bounds.extend(routePts[rp]);
                        hasBounds = true;
                    }
                    if (useDirections) {
                        hangyoDirectionsApplyRoute(
                            g,
                            routePts,
                            bounds,
                            dc,
                            dz,
                            hasBounds,
                            routingGen,
                            distanceOnly
                        );
                    } else {
                        if (!distanceOnly) {
                            hangyoAttachStraightPolyline(g, routePts, bounds);
                        }
                        postHaversineDistanceKm(routingGen, routePts);
                    }
                }

                if (hasBounds) {
                    map.fitBounds(bounds, 56);
                } else {
                    map.setCenter(dc);
                    map.setZoom(dz);
                }

                return true;
            }

            function postToHangyoAncestors(data) {
                var payload = {};
                var k;
                for (k in data) {
                    if (Object.prototype.hasOwnProperty.call(data, k)) {
                        payload[k] = data[k];
                    }
                }
                // LEX nested frames can expose an outer event.origin (e.g. *.lightning.force.com).
                // The parent MUST post back using the embedded document origin (*.vf.force.com).
                payload.embedOrigin = window.location.origin || '';

                var targetOrigin = HANGYO_TRUSTED_PARENT_ORIGIN;
                if (!targetOrigin || !hangyoIsTrustedLightningParentOrigin(targetOrigin)) {
                    if (typeof console !== 'undefined' && console.error) {
                        console.error(
                            '[UserTrackingMapEmbed] Cannot postMessage: trusted Salesforce parent origin is unknown. ' +
                                'Deploy UserTrackingController.getUserTrackingMapEmbedUrl() with hpo param; never use wildcard "*".'
                        );
                    }
                    return;
                }

                var json = JSON.stringify(payload);
                try {
                    if (window.parent && window.parent !== window) {
                        window.parent.postMessage(json, targetOrigin);
                    }
                } catch (e1) {}
                try {
                    var t = window.top;
                    if (t && t !== window && t !== window.parent) {
                        t.postMessage(json, targetOrigin);
                    }
                } catch (e2) {}
            }

            function tryApplyPending() {
                if (!pendingPayload) {
                    return;
                }
                if (renderPayload(pendingPayload)) {
                    pendingPayload = null;
                }
            }

            function postMapFailureToParent(message) {
                postToHangyoAncestors({
                    type: 'HANGYO_MAP_LOAD_FAILED',
                    message: message || 'Google Maps did not load in this frame.'
                });
            }

            function hangyoMapReflow() {
                var g = window.google && window.google.maps;
                if (!map || !g || !g.event) {
                    return;
                }
                try {
                    g.event.trigger(map, 'resize');
                } catch (exRf) {}
            }

            window.addEventListener('message', function (e) {
                if (!hangyoIsTrustedSalesforceOrigin(e.origin)) {
                    return;
                }
                var d = e.data;
                if (typeof d === 'string') {
                    if (2 > d.length || d.charAt(0) !== '{') {
                        return;
                    }
                    try {
                        d = JSON.parse(d);
                    } catch (ex) {
                        return;
                    }
                }
                if (!d || typeof d !== 'object') {
                    return;
                }
                if (d.type === 'HANGYO_MAP_REFLOW') {
                    hangyoMapReflow();
                    return;
                }
                if (d.type !== 'HANGYO_MAP_ROUTE') {
                    return;
                }
                pendingPayload = {
                    path: d.path || [],
                    markers: d.markers || [],
                    defaultCenter: d.defaultCenter || DEFAULT_CENTER,
                    defaultZoom: typeof d.defaultZoom === 'number' ? d.defaultZoom : DEFAULT_ZOOM,
                    renderMode: d.renderMode === 'distanceOnly' ? 'distanceOnly' : 'full',
                    routingMode: d.routingMode === 'directions' ? 'directions' : 'haversine',
                    forceRouteRender: d.forceRouteRender === true
                };
                tryApplyPending();
            });

            window.hangyoMapsCb = function () {
                postToHangyoAncestors({ type: 'HANGYO_MAP_EMBED_READY' });
                tryApplyPending();
            };

            function hangyoMapScriptFailed() {
                if (window.google && window.google.maps) {
                    return;
                }
                var el = document.getElementById('hangyoMap');
                var scriptMsg =
                    'Could not load the Google Maps script from maps.googleapis.com (network/DNS block, CSP or Trusted URLs, API key referrer restrictions, HTML error page returned instead of JavaScript — add *.vf.force.com/*.sandbox.vf.force.com/.my.salesforce.com to HTTP referrers — or invalid key).';
                showMapsLoadError(el);
                postMapFailureToParent(scriptMsg);
            }

            try {
                postToHangyoAncestors({ type: 'HANGYO_MAP_SHELL_READY' });
            } catch (eShell) {}

            function showMapsLoadError(el) {
                if (!el || map) {
                    return;
                }
                while (el.firstChild) {
                    el.removeChild(el.firstChild);
                }
                var wrap = document.createElement('div');
                wrap.style.cssText =
                    'padding:16px;font-family:Segoe UI,Arial,sans-serif;font-size:13px;color:#333;line-height:1.55';
                wrap.appendChild(
                    document.createTextNode(
                        'Google Maps did not load in this frame. Check: Maps JavaScript API enabled, billing on the Google Cloud project, Custom Label '
                    )
                );
                var s1 = document.createElement('strong');
                s1.appendChild(document.createTextNode('Google_Maps_API_Key'));
                wrap.appendChild(s1);
                wrap.appendChild(document.createTextNode(', and Salesforce '));
                var s2 = document.createElement('strong');
                s2.appendChild(document.createTextNode('Trusted URLs'));
                wrap.appendChild(s2);
                wrap.appendChild(
                    document.createTextNode(
                        ' for maps.googleapis.com / *.gstatic.com, and HTTP referrer restriction on API key '
                    )
                );
                var s3 = document.createElement('strong');
                s3.appendChild(
                    document.createTextNode(
                        'https://*.vf.force.com/* and https://*.sandbox.vf.force.com/* (Visualforce)'
                    )
                );
                wrap.appendChild(s3);
                wrap.appendChild(document.createTextNode('.'));
                el.appendChild(wrap);
            }

            window.setTimeout(function () {
                if (window.google && window.google.maps) {
                    return;
                }
                var el = document.getElementById('hangyoMap');
                var failMsg =
                    'Google Maps did not load within 12 seconds. Check: Maps JavaScript API enabled, billing on the Google Cloud project, Custom Label Google_Maps_API_Key, VF HTTP referrers on the key (*.vf.force.com/*.sandbox.vf.force.com/*.my.salesforce.com), and Trusted URLs for maps.googleapis.com and *.gstatic.com.';
                showMapsLoadError(el);
                postMapFailureToParent(failMsg);
                try {
                    postToHangyoAncestors({ type: 'HANGYO_MAP_EMBED_READY' });
                } catch (e2) {}
            }, 12000);

            function hangyoAppendGoogleMaps() {
                if (document.getElementById('hangyoGoogleMapsSdk')) {
                    return;
                }
                var k = (HANGYO_GM_KEY || '').trim();
                var elFallback = document.getElementById('hangyoMap');
                if (!k) {
                    showMapsLoadError(elFallback);
                    postMapFailureToParent('Custom Label Google_Maps_API_Key is empty.');
                    postToHangyoAncestors({ type: 'HANGYO_MAP_EMBED_READY' });
                    return;
                }
                var sc = document.createElement('script');
                sc.id = 'hangyoGoogleMapsSdk';
                sc.async = true;
                sc.defer = true;
                sc.onerror = hangyoMapScriptFailed;
                sc.src =
                    'https://maps.googleapis.com/maps/api/js?key=' +
                    encodeURIComponent(k) +
                    '&libraries=geometry&loading=async&callback=hangyoMapsCb';
                document.head.appendChild(sc);
            }

            hangyoAppendGoogleMaps();
        })();
    </script>
</head>
<body>
    <div id="hangyoMap"></div>
</body>
</html>
</apex:page>