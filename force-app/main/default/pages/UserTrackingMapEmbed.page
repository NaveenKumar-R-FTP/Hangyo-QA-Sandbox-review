<apex:page showHeader="false"
    sidebar="false"
    standardStylesheets="false"
    docType="html-5.0"
    applyHtmlTag="false"
    cache="false"
>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="initial-scale=1,maximum-scale=1,width=device-width" />
    <style type="text/css">
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            background: #ffffff;
        }
        #hangyoMap {
            height: 100%;
            width: 100%;
            background: #ffffff;
        }

        /*
         * Maps injects layered wrappers — default white fills read as a halo outside our rounded black border.
         * Clear backgrounds/box-shadow on those shells; our card carries the real shape + drop-shadow.
         */
        #hangyoMap .gm-style .gm-style-iw,
        #hangyoMap .gm-style .gm-style-iw-ch,
        #hangyoMap .gm-style .gm-style-iw-chr,
        #hangyoMap .gm-style .gm-style-iw-tc {
            background-color: transparent !important;
            background: transparent !important;
            box-shadow: none !important;
        }
        #hangyoMap .gm-style-iw-c {
            padding: 0 !important;
            border-radius: 0 !important;
            outline: none;
            max-height: none !important;
            background-color: transparent !important;
            background: transparent !important;
            box-shadow: none !important;
        }
        #hangyoMap .gm-style .gm-style-iw-ch,
        #hangyoMap .gm-style .gm-style-iw-chr {
            padding: 0 !important;
            margin: 0 !important;
            max-height: none !important;
            height: auto !important;
            min-height: 0 !important;
        }
        #hangyoMap .gm-style .gm-style-iw-tc {
            padding-top: 0 !important;
            height: auto !important;
            max-height: none !important;
        }
        #hangyoMap .gm-style .gm-style-iw-t::after {
            display: none !important;
            height: 0 !important;
        }
        #hangyoMap .gm-style-iw-d {
            padding: 0 !important;
            margin: 0 !important;
            overflow: visible !important;
            max-height: none !important;
            background-color: transparent !important;
            background: transparent !important;
            box-shadow: none !important;
        }
        /* Inline max-height on scroll panes survives without this (clips extra detail rows). */
        #hangyoMap .gm-style-iw-d[style] {
            max-height: none !important;
            overflow: visible !important;
        }
        /* Default Maps close sits in a dedicated white strip — hide it; we use Hangyo header close. */
        #hangyoMap .gm-style .gm-ui-hover-effect,
        #hangyoMap .gm-style-iw-c > button {
            display: none !important;
            opacity: 0 !important;
            pointer-events: none !important;
            width: 0 !important;
            height: 0 !important;
        }

        /*
         * Hangyo brand aligns with Lightning dashboard (see userTrackingDashboard.css --hangyo-brand).
         * Thick border + tinted header mimic client mockup without extra Maps padding above title.
         */
        .hangyo-iw-brand {
            --hangyo-infowin-brand: #c1206b;
            --hangyo-infowin-on-brand: #ffffff;
            margin: 0;
            padding: 0;
            /* Shadow on wrapper so rounded card can use overflow:hidden without clipping elevation. */
            filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.14));
        }

        .hangyo-iw-card {
            margin: 0;
            overflow: hidden;
            border-radius: 10px;
            border: 3px solid #181818;
            background: #ffffff;
            box-sizing: border-box;
            box-shadow: none;
            min-width: 240px;
            max-width: 320px;
        }

        .hangyo-iw-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: var(--hangyo-infowin-brand);
            color: var(--hangyo-infowin-on-brand);
            font-weight: 700;
            font-size: 14px;
            line-height: 1.35;
            margin: 0;
            padding: 11px 12px 11px 14px;
            letter-spacing: 0.03em;
            box-sizing: border-box;
        }

        .hangyo-iw-head-title {
            flex: 1;
            min-width: 0;
        }

        /* Ghost into header — avoids a chunky boxed look for the × on magenta. */
        .hangyo-iw-close {
            flex-shrink: 0;
            box-sizing: border-box;
            width: 30px;
            height: 30px;
            margin: 0;
            padding: 0;
            border: 0;
            border-radius: 4px;
            background: transparent;
            color: var(--hangyo-infowin-on-brand);
            font-size: 26px;
            font-weight: 300;
            line-height: 1;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: none;
            -webkit-tap-highlight-color: transparent;
        }

        .hangyo-iw-close:hover {
            background: rgba(255, 255, 255, 0.14);
        }

        .hangyo-iw-close:focus {
            outline: none;
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.55);
        }

        .hangyo-iw-close:focus-visible {
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.75);
        }

        /*
         * ~4 rows visible (single-line rows); remainder scrolls inside the white body.
         * padding + row1 lh + rows 2-4 (gap + lh) + bottom pad + rounding slack.
         */
        .hangyo-iw-body {
            font: 12px/1.45 'Segoe UI', Arial, sans-serif;
            color: #212121;
            padding: 12px 8px 12px 14px;
            margin: 0;
            box-sizing: border-box;
            background: #ffffff;
            max-height: calc(
                12px + (12px * 1.45) + 3 * (8px + (12px * 1.45)) + 12px + 6px
            );
            overflow-y: auto;
            overflow-x: hidden;
            -webkit-overflow-scrolling: touch;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
            scrollbar-width: thin;
            scrollbar-color: rgba(193, 32, 107, 0.45) rgba(0, 0, 0, 0.04);
        }

        .hangyo-iw-body::-webkit-scrollbar {
            width: 7px;
        }

        .hangyo-iw-body::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.035);
            border-radius: 4px;
            margin: 6px 0;
        }

        .hangyo-iw-body::-webkit-scrollbar-thumb {
            background: rgba(193, 32, 107, 0.45);
            border-radius: 4px;
        }

        .hangyo-iw-body::-webkit-scrollbar-thumb:hover {
            background: rgba(193, 32, 107, 0.65);
        }

        .hangyo-iw-row {
            margin: 8px 0 0;
            word-wrap: break-word;
        }
        .hangyo-iw-row:first-child {
            margin-top: 0;
        }

        .hangyo-iw-key {
            color: #3e3938;
            font-weight: 600;
            display: inline-block;
            min-width: 112px;
            vertical-align: top;
        }

        /* Fallback if class applied without card wrapper */
        .hangyo-iw {
            font: 12px/1.45 'Segoe UI', Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
    </style>
    <script type="text/javascript">
        (function () {
            //API KEY
            var HANGYO_GM_KEY = '{!JSENCODE($Label.Google_Maps_API_Key)}';

            /**
             * Trusted LEX parent origin for VF → LWC postMessage.
             * Wildcard '*' exposes route/activity payloads to any origin — never use it.
             * Resolved from hpo query param (UserTrackingController.getUserTrackingMapEmbedUrl)
             * with document.referrer as a validated fallback only.
             */
            function hangyoParseQueryParam(name) {
                var search = window.location.search || '';
                if (!search || search.length < 2) {
                    return '';
                }
                var parts = search.substring(1).split('&');
                var i;
                for (i = 0; i < parts.length; i++) {
                    var pair = parts[i].split('=');
                    if (pair[0] === name && pair.length > 1) {
                        try {
                            return decodeURIComponent(pair.slice(1).join('=').replace(/\+/g, ' '));
                        } catch (exDec) {
                            return pair.slice(1).join('=');
                        }
                    }
                }
                return '';
            }

            /**
             * Explicit Salesforce hostname suffixes — never indexOf/includes on the origin string.
             * Substring checks accept spoofed hosts (e.g. https://fake-force.com contains ".force.com").
             */
            var HANGYO_TRUSTED_SF_HOST_SUFFIXES = [
                '.vf.force.com',
                '.sandbox.vf.force.com',
                '.visualforce.com',
                '.lightning.force.com',
                '.my.salesforce.com',
                '.sandbox.my.salesforce.com',
                '.cloudforce.com'
            ];

            var HANGYO_TRUSTED_PARENT_HOST_SUFFIXES = [
                '.lightning.force.com',
                '.my.salesforce.com',
                '.sandbox.my.salesforce.com'
            ];

            function hangyoHostnameMatchesSuffixList(hostname, suffixList) {
                if (!hostname || typeof hostname !== 'string') {
                    return false;
                }
                var h = hostname.toLowerCase();
                var i;
                for (i = 0; i < suffixList.length; i++) {
                    if (h.endsWith(suffixList[i])) {
                        return true;
                    }
                }
                return false;
            }

            function hangyoIsTrustedSalesforceOrigin(origin) {
                if (origin == null || typeof origin !== 'string') {
                    return false;
                }
                var trimmed = origin.trim();
                if (!trimmed) {
                    return false;
                }
                try {
                    var parsed = new URL(trimmed);
                    if (parsed.protocol !== 'https:') {
                        return false;
                    }
                    return hangyoHostnameMatchesSuffixList(
                        parsed.hostname,
                        HANGYO_TRUSTED_SF_HOST_SUFFIXES
                    );
                } catch (exOrigin) {
                    return false;
                }
            }

            function hangyoIsTrustedLightningParentOrigin(origin) {
                if (origin == null || typeof origin !== 'string') {
                    return false;
                }
                var trimmed = origin.trim();
                if (!trimmed) {
                    return false;
                }
                try {
                    var parsed = new URL(trimmed);
                    if (parsed.protocol !== 'https:') {
                        return false;
                    }
                    return hangyoHostnameMatchesSuffixList(
                        parsed.hostname,
                        HANGYO_TRUSTED_PARENT_HOST_SUFFIXES
                    );
                } catch (exParent) {
                    return false;
                }
            }

            function hangyoResolveTrustedParentPostMessageOrigin() {
                var fromUrl = hangyoParseQueryParam('hpo');
                if (hangyoIsTrustedLightningParentOrigin(fromUrl)) {
                    return fromUrl.trim();
                }
                try {
                    var ref = document.referrer;
                    if (ref) {
                        var refOrigin = new URL(ref).origin;
                        if (hangyoIsTrustedLightningParentOrigin(refOrigin)) {
                            return refOrigin;
                        }
                    }
                } catch (exRef) {}
                return '';
            }

            var HANGYO_TRUSTED_PARENT_ORIGIN = hangyoResolveTrustedParentPostMessageOrigin();

            var map;
            var polyline;
            var activityMarkers = [];

            var mapHoverInfoWindow = null;
            var hangyoLegendControlPushed = false;

            /** Incremented each render — stale Directions callbacks skip drawing. */
            var routeRequestGen = 0;
            /** Lazy init after google.maps loads. */
            var directionsService = null;
            var directionsRenderer = null;

            function hangyoHideDirectionsRenderer() {
                if (directionsRenderer) {
                    try {
                        directionsRenderer.setMap(null);
                    } catch (ehDr) {}
                }
            }

            var pendingPayload = null;

            var DEFAULT_CENTER = { lat: 12.9716, lng: 77.5946 };
            var DEFAULT_ZOOM = 11;
            /** Google allows origin + destination + max 23 stopover waypoints per request */
            var DIRECTIONS_MAX_INTERMEDIATE = 23;
            /** Origin + destination + 23 waypoints = 25 tracked positions in one Directions call */
            var GOOGLE_DIRECTIONS_MAX_POSITIONS_SINGLE = 25;
            /** Transient Directions failures: brief backoff per Google troubleshooting patterns */
            var HANGYO_DIRECTIONS_RETRY_ATTEMPTS = 3;
            var HANGYO_DIRECTIONS_RETRY_BASE_MS = 400;
            /** Paced chained Directions calls reduce OVER_QUERY_LIMIT risk on chunked routes */
            var HANGYO_DIRECTIONS_CHUNK_GAP_MS = 100;
            //Added by Hari - For rectify the production issue for no line in map
            var HANGYO_DIRECTIONS_REQUEST_TIMEOUT_MS = 20000;
            //Added by Hari - For rectify the production issue for no line in map
            var HANGYO_DIRECTIONS_ROUTE_WATCHDOG_MS = 60000;
            //Added by Hari - For rectify the production issue for no line in map
            var directionsRouteWatchdog = null;
            //Added by Hari - For rectify the production issue for no line in map
            var routeLineSettledForGen = 0;
            /** Skip duplicate HANGYO_MAP_ROUTE while a Directions chain for the same payload is in flight. */
            var hangyoLastRoutePayloadFingerprint = '';
            /** Generation with an active Directions request (cleared when route line settles). */
            var routeDirectionsInFlightGen = 0;

            var HANGYO_ROUTE_STROKE = '#D32F2F';
            var HANGYO_ROUTE_WEIGHT = 4;
            /** Skip consecutive path points at almost the same GPS (duplicate rows / same site). */
            var HANGYO_PATH_CONSEC_DEDUP_DEG_SQ = 1.0e-7;
            /**
             * If the day's last coordinate is essentially a return to the starting area, Directions draws a closed loop.
             * Drop that closing point for routing so the trace is one open line (markers still include all stops).
             */
            var HANGYO_LOOP_RETURN_DEG_SQ = 3.6e-7;

            /** True if adjacent latlng are the same junction (overlap between chunked routes). */
            function hangyoLngLatClose(a, b) {
                if (!a || !b) return false;
                return (
                    1e-9 > Math.abs(Number(a.lat) - Number(b.lat)) &&
                    1e-9 > Math.abs(Number(a.lng) - Number(b.lng))
                );
            }

            /** Sanitized {lat,lng} list from dashboard path (preserve order, dedupe streaks, trim return loop for routing). */
            function hangyoSanitizeLatLngPath(pathArr) {
                var raw = [];
                var i;
                for (i = 0; pathArr.length > i; i++) {
                    var pt = pathArr[i];
                    var la = Number(pt && pt.lat);
                    var ln = Number(pt && pt.lng);
                    if (!isFinite(la) || !isFinite(ln)) {
                        continue;
                    }
                    raw.push({ lat: la, lng: ln });
                }
                var pts = [];
                for (i = 0; raw.length > i; i++) {
                    if (
                        pts.length === 0 ||
                        HANGYO_PATH_CONSEC_DEDUP_DEG_SQ <=
                            hangyoPlanarSqDeg(
                                pts[pts.length - 1].lat,
                                pts[pts.length - 1].lng,
                                raw[i].lat,
                                raw[i].lng
                            )
                    ) {
                        pts.push(raw[i]);
                    }
                }
                if (
                    pts.length >= 3 &&
                    HANGYO_LOOP_RETURN_DEG_SQ >
                        hangyoPlanarSqDeg(
                            pts[0].lat,
                            pts[0].lng,
                            pts[pts.length - 1].lat,
                            pts[pts.length - 1].lng
                        )
                ) {
                    return pts.slice(0, pts.length - 1);
                }
                return pts;
            }

            /**
             * Valid coordinates in dashboard order — does not drop nearby consecutive stops.
             * Near-duplicate GPS is expanded (same spiral as markers) so route + km reflect every visit.
             */
            function hangyoPathLiteralsValidOnly(pathArr) {
                var raw = [];
                var i;
                for (i = 0; pathArr.length > i; i++) {
                    var pt = pathArr[i];
                    var la = Number(pt && pt.lat);
                    var ln = Number(pt && pt.lng);
                    if (isFinite(la) && isFinite(ln)) {
                        raw.push({ lat: la, lng: ln });
                    }
                }
                return raw;
            }

            function hangyoPathForRouting(pathArr) {
                var literals = hangyoPathLiteralsValidOnly(pathArr);
                if (literals.length < 2) {
                    return literals;
                }
                var prep = [];
                var pi;
                for (pi = 0; literals.length > pi; pi++) {
                    prep.push({ lat: literals[pi].lat, lng: literals[pi].lng });
                }
                hangyoApplyCoincidentMarkerDisplayPositions(prep);
                var out = [];
                for (pi = 0; prep.length > pi; pi++) {
                    out.push({
                        lat:
                            prep[pi]._dispLat != null && isFinite(Number(prep[pi]._dispLat))
                                ? Number(prep[pi]._dispLat)
                                : prep[pi].lat,
                        lng:
                            prep[pi]._dispLng != null && isFinite(Number(prep[pi]._dispLng))
                                ? Number(prep[pi]._dispLng)
                                : prep[pi].lng
                    });
                }
                return out;
            }

            function hangyoHaversineMeters(a, b) {
                var R = 6371000;
                var lat1 = (Number(a.lat) * Math.PI) / 180;
                var lat2 = (Number(b.lat) * Math.PI) / 180;
                var dLat = lat2 - lat1;
                var dLng = ((Number(b.lng) - Number(a.lng)) * Math.PI) / 180;
                var h =
                    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                    Math.cos(lat1) *
                        Math.cos(lat2) *
                        Math.sin(dLng / 2) *
                        Math.sin(dLng / 2);
                return 2 * R * Math.asin(Math.min(1, Math.sqrt(h)));
            }

            function hangyoSumGeodesicPathMeters(pts) {
                if (!pts || pts.length < 2) {
                    return 0;
                }
                var sum = 0;
                var i;
                for (i = 1; pts.length > i; i++) {
                    sum += hangyoHaversineMeters(pts[i - 1], pts[i]);
                }
                return sum;
            }

            /** Maps Polylines are most reliable when the path is LatLng[], not anonymous objects. */
            function hangyoPathLiteralsToMvcPath(g, literals) {
                var out = [];
                if (!g || !literals || !literals.length) {
                    return out;
                }
                var i;
                for (i = 0; literals.length > i; i++) {
                    var np = hangyoNormalizeLatLngPoint(literals[i]);
                    if (np) {
                        out.push(new g.LatLng(np.lat, np.lng));
                    }
                }
                return out;
            }

            /** Normalize mixed LatLng / literal arrays before prune or polyline draw. */
            function hangyoSanitizePathLiteralsForDraw(path) {
                var out = [];
                var i;
                if (!path || !path.length) {
                    return out;
                }
                for (i = 0; path.length > i; i++) {
                    var np = hangyoNormalizeLatLngPoint(path[i]);
                    if (np) {
                        out.push(np);
                    }
                }
                return out;
            }

            function hangyoAttachStraightPolyline(g, pts, bounds) {
                hangyoHideDirectionsRenderer();
                if (polyline) {
                    polyline.setMap(null);
                    polyline = null;
                }
                var mvc = hangyoPathLiteralsToMvcPath(g, pts);
                if (mvc.length < 2) {
                    return;
                }
                polyline = new g.Polyline({
                    path: mvc,
                    geodesic: true,
                    strokeColor: HANGYO_ROUTE_STROKE,
                    strokeOpacity: 0.92,
                    strokeWeight: HANGYO_ROUTE_WEIGHT,
                    zIndex: 320,
                    map: map
                });
                var pi;
                for (pi = 0; mvc.length > pi; pi++) {
                    bounds.extend(mvc[pi]);
                }
            }

            /** Google LatLng instances can expose .lat()/.lng(), or readable number properties (.lat/.lng). */
            function hangyoNormalizeLatLngPoint(ll) {
                if (!ll || typeof ll !== 'object') {
                    return null;
                }
                var la;
                var ln;
                if (typeof ll.lat === 'function' && typeof ll.lng === 'function') {
                    la = Number(ll.lat());
                    ln = Number(ll.lng());
                } else {
                    la = Number(ll.lat);
                    ln = Number(ll.lng);
                }
                return isFinite(la) && isFinite(ln) ? { lat: la, lng: ln } : null;
            }

            /** Decoded {lat,lng}[] from Directions overview_polyline.points (when overview_path verts are absent). */
            function hangyoDecodeEncodedPolyline(pointsStr) {
                try {
                    var path = [];
                    if (!pointsStr || typeof pointsStr !== 'string') {
                        return path;
                    }
                    var index = 0;
                    var len = pointsStr.length;
                    var lat = 0;
                    var lng = 0;
                    var iterations = 0;
                    /** Corrupt/stray strings must not wedge the iframe script */
                    while (len > index && 8192 > iterations++) {
                        var b;
                        var shift = 0;
                        var result = 0;
                        do {
                            if (!(len > index)) {
                                return path;
                            }
                            b = pointsStr.charCodeAt(index++) - 63;
                            result |= (b & 0x1f) << shift;
                            shift += 5;
                        } while (b >= 32);
                        var dlat = result & 1 ? ~(result >> 1) : result >> 1;
                        lat += dlat;
                        shift = 0;
                        result = 0;
                        do {
                            if (!(len > index)) {
                                return path;
                            }
                            b = pointsStr.charCodeAt(index++) - 63;
                            result |= (b & 0x1f) << shift;
                            shift += 5;
                        } while (b >= 32);
                        var dlng = result & 1 ? ~(result >> 1) : result >> 1;
                        lng += dlng;
                        path.push({ lat: lat / 100000, lng: lng / 100000 });
                    }
                    return path;
                } catch (exDl) {
                    return [];
                }
            }

            function hangyoOverviewPathToLiterals(overviewPath) {
                var out = [];
                if (!overviewPath) return out;
                var i;
                if (typeof overviewPath.getLength === 'function' && typeof overviewPath.getAt === 'function') {
                    for (i = 0; overviewPath.getLength() > i; i++) {
                        var nm = hangyoNormalizeLatLngPoint(overviewPath.getAt(i));
                        if (nm) {
                            out.push(nm);
                        }
                    }
                    return out;
                }
                if (!overviewPath.length) {
                    return out;
                }
                for (i = 0; overviewPath.length > i; i++) {
                    var norm = hangyoNormalizeLatLngPoint(overviewPath[i]);
                    if (norm) {
                        out.push(norm);
                    }
                }
                return out;
            }

            /** One Directions step polyline → {lat,lng}[] */
            function hangyoStepPathToLiterals(step) {
                var out = [];
                if (!step || !step.path) {
                    return out;
                }
                var p = step.path;
                var i;
                var ll;
                var np;
                if (typeof p.getLength === 'function' && typeof p.getAt === 'function') {
                    for (i = 0; p.getLength() > i; i++) {
                        ll = p.getAt(i);
                        np = hangyoNormalizeLatLngPoint(ll);
                        if (np) {
                            out.push(np);
                        }
                    }
                    return out;
                }
                if (p.length) {
                    for (i = 0; p.length > i; i++) {
                        np = hangyoNormalizeLatLngPoint(p[i]);
                        if (np) {
                            out.push(np);
                        }
                    }
                }
                return out;
            }

            /**
             * Full driving geometry from leg steps (avoids overview_path forks / double corridors). Falls back elsewhere.
             */
            function hangyoRouteToDetailPathLiterals(route) {
                var acc = [];
                if (!route || !route.legs || !route.legs.length) {
                    return acc;
                }
                var li;
                for (li = 0; route.legs.length > li; li++) {
                    var leg = route.legs[li];
                    /** Incomplete leg: keep partial detail if usable, otherwise caller falls back */
                    if (!leg || !leg.steps || !leg.steps.length) {
                        return acc.length >= 2 ? acc : [];
                    }
                    var si;
                    for (si = 0; leg.steps.length > si; si++) {
                        var chunk = hangyoStepPathToLiterals(leg.steps[si]);
                        var ci;
                        for (ci = 0; chunk.length > ci; ci++) {
                            var pt = chunk[ci];
                            if (
                                acc.length === 0 ||
                                HANGYO_PATH_CONSEC_DEDUP_DEG_SQ <=
                                    hangyoPlanarSqDeg(
                                        acc[acc.length - 1].lat,
                                        acc[acc.length - 1].lng,
                                        pt.lat,
                                        pt.lng
                                    )
                            ) {
                                acc.push(pt);
                            }
                        }
                    }
                }
                return acc;
            }

            /** Directions route exposes encoded overview on overview_polyline (string .points or function). */
            function hangyoEncodedOverviewPoints(route) {
                if (!route || !route.overview_polyline) {
                    return '';
                }
                var op = route.overview_polyline;
                if (typeof op === 'string') {
                    return op;
                }
