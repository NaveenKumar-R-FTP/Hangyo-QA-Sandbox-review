            /**
             * Salesforce rows can land a few metres apart ("same outlet") but rounded keys miss that.
             * Cluster by planar distance (~60 m) and spiral offsets ~40 m+ so labels stay readable when zoomed to route.
             */
            var HANGYO_CLUSTER_RADIUS_DEG_SQ = 2.85e-7;

            function hangyoPlanarSqDeg(lat1, lng1, lat2, lng2) {
                var avgLatRad = (((lat1 + lat2) / 2) * Math.PI) / 180;
                var dy = lat1 - lat2;
                var scaledLngDelta = (lng1 - lng2) * Math.cos(avgLatRad);
                return dy * dy + scaledLngDelta * scaledLngDelta;
            }

            function hangyoWithinClusterDist(aLat, aLng, bLat, bLng) {
                return HANGYO_CLUSTER_RADIUS_DEG_SQ > hangyoPlanarSqDeg(aLat, aLng, bLat, bLng);
            }

            /** slot 0 anchored to earliest record in cluster at its true coords. */
            function hangyoOffsetCoincidentSlot(lat, lng, slotWithinGroup, groupTotal) {
                if (!slotWithinGroup || 1 >= groupTotal) {
                    return { lat: lat, lng: lng };
                }
                var TWO_PI = Math.PI * 2;
                var rDegBase = 0.000365;
                var ring = Math.floor((slotWithinGroup - 1) / 8);
                var posInRing = (slotWithinGroup - 1) % 8;
                var angle = TWO_PI * (posInRing + 1) / 8 + ring * 0.28;
                var radScale = ring + 1;
                var step = rDegBase * radScale;
                var latRad = (lat * Math.PI) / 180;
                return {
                    lat: lat + step * Math.cos(angle),
                    lng: lng + (step * Math.sin(angle)) / Math.cos(latRad || 1e-6)
                };
            }

            /** Mutates rows with _dispLat/_dispLng; preserves dashboard order inside each spatial cluster (earliest anchored). */
            function hangyoApplyCoincidentMarkerDisplayPositions(rows) {
                var n = rows.length;
                if (!n) {
                    return;
                }
                var seen = [];
                var gi;
                for (gi = 0; n > gi; gi++) {
                    seen[gi] = false;
                }
                var qi;
                for (qi = 0; n > qi; qi++) {
                    if (seen[qi]) {
                        continue;
                    }
                    var stack = [];
                    stack.push(qi);
                    seen[qi] = true;
                    var groupIdx = [];
                    while (stack.length) {
                        var popIdx = stack.pop();
                        groupIdx.push(popIdx);
                        var vi;
                        for (vi = 0; n > vi; vi++) {
                            if (seen[vi]) {
                                continue;
                            }
                            var ra = rows[popIdx];
                            var rb = rows[vi];
                            if (
                                hangyoWithinClusterDist(ra.lat, ra.lng, rb.lat, rb.lng)
                            ) {
                                seen[vi] = true;
                                stack.push(vi);
                            }
                        }
                    }
                    groupIdx.sort(function (aIdx, bIdx) {
                        return aIdx - bIdx;
                    });
                    var gx;
                    var gLen = groupIdx.length;
                    var anchorLat = rows[groupIdx[0]].lat;
                    var anchorLng = rows[groupIdx[0]].lng;
                    for (gx = 0; groupIdx.length > gx; gx++) {
                        var rRow = rows[groupIdx[gx]];
                        var offSlot = gx;
                        var oDisp = hangyoOffsetCoincidentSlot(anchorLat, anchorLng, offSlot, gLen);
                        rRow._dispLat = oDisp.lat;
                        rRow._dispLng = oDisp.lng;
                    }
                }
            }

