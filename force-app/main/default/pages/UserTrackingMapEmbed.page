            function colorForActivityType(t) {
                var s = hangyoNormalizeActLabel(t);
                if (!s) {
                    return '#757575';
                }
                if (s.indexOf('attendance') !== -1) {
                    return '#FFEB3B';
                }
                if (s.indexOf('eod') !== -1) {
                    return '#1976D2';
                }
                /* New outlet before productive / non-productive (word "outlet" appears in several types). */
                if (s.indexOf('new outlet') !== -1 || s.indexOf('new-outlet') !== -1) {
                    return '#212121';
                }
                if (s.indexOf('non') !== -1 && s.indexOf('productive') !== -1) {
                    return '#D32F2F';
                }
                if (
                    s.indexOf('productive') !== -1 ||
                    s.indexOf('order') !== -1 ||
                    s.indexOf('sales') !== -1
