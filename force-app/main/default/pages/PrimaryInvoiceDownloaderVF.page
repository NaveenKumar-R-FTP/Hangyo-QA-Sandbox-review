<apex:page controller="PrimaryInvoiceDownloaderCtl" standardStylesheets="false" renderAs="pdf" showHeader="false" applyBodyTag="false" applyHtmlTag="false" readOnly="true" cache="false">
    
    <html>
        <head>
            <meta http-equiv="Content-Type" content="text/html;charset=UTF-8"/>
            <style>
                .qrWrapper img{
                    width:70px !important;
                    height:70px !important;
                    object-fit:contain;
                }
            </style>
            <style>
                @page{
                    size:A4;
                    margin:1mm;
                    margin-top:139px;
                    margin-bottom:40px;
                    @top-left{ content:element(header); }
                    @bottom-center{ content:element(footer); }
                }
                
                body{ 
                    font-family:Tahoma; 
                    font-size:10pt;
                    margin-left:6px;
                    margin-right:12px;
                }
                
                table{ page-break-inside:auto; border-collapse:collapse; width:100%; }
                tr{ page-break-inside:avoid; }
                
                .header{
                    position:running(header);
                    width:98%;
                    margin-left:5px;
                }
                
                .headerBox{
                    border:1px solid black;
                    padding:6px;
                    margin-top:2px;
                }
                
                .title{ font-size:11pt; font-weight:bold; text-align:center; }
                .subtitle{ font-size:8pt; text-align:center; }
                .companyName{ font-size:14pt; font-weight:bold; }
                .companyBlock{ font-size:10pt; font-weight:bold; }
                
                .maintable td,.maintable th{
                    border:1px solid black;
                    padding:2px;
                    font-size:8pt;
                }
                
                .headerRow th{
                    font-size:8pt;
                    font-weight:bold;
                    background:#d9d9d9;
                }
                
                .title{
                    font-size:18px;
                    font-weight:bold;
                }
                .subtitle{
                    font-size:11px;
                    
                }
                
                .totalRow td{ font-weight:bold; }
                .summaryRow td{ font-size:8pt; }
                
                .gstHead td{
                    font-size:7pt;
                    font-weight:bold;
                    background:#d9d9d9;
                }
                
                .gstRow td{ font-size:7pt; }
                
                .termsTitle{ font-size:7pt; font-weight:bold; }
                .sign{ font-size:8pt; font-weight:bold; }
                .signNote{ font-size:8pt; }
                
                #footer{
                    position:running(footer);
                    text-align:center;
                    font-size:10px;
                }
                
                .page-number:before{
                    content:"Page " counter(page) " of " counter(pages);
                }
                
                body, table, td, th, tr, div, span {
                    font-family: Tahoma !important;
                }
                
                .invoiceBody,
                .invoiceBody table,
                .invoiceBody td,
                .invoiceBody th,
                .invoiceBody div,
                .invoiceBody span {
                    font-size: 9pt !important;
                }

            </style>
        </head>
    
    <body>
    
    <!-- ================= HEADER ================= -->
    <div class="header">
        <div class="headerBox">
    
            <table width="100%" style="border-collapse:collapse; height:100%;">
    
                <!-- ROW 1 : 85% CONTENT -->
                <tr style="height:90%;">
    
                    <!-- LEFT 15% : LOGO -->
                    <td width="15%" valign="top" style="text-align:left;">
                        <img src="{!dmsUserInfo.MediumPhotoUrl}" width="80" height="80"/>
                    </td>
    
                    <!-- CENTER 70% : TITLE + COMPANY DETAILS -->
                    <td width="70%" valign="top" style="text-align:center;">
    
                        <div class="title">Tax Invoice</div>
                        <div class="subtitle">(Original For Recipient)</div>
    
                        <div class="companyName">
                            {!companyName}
                        </div>
    
                        <div class="companyBlock">
                            {!$Label.Company_BillingStreet},
                            {!$Label.Company_BillingCity},
                            {!$Label.Company_BillingState},
                            {!$Label.Company_BillingCountry}
                        </div>
    
                    </td>
    
                    <!-- RIGHT 15% : QR -->
                    <td width="15%" valign="top" style="text-align:right;">
                        <!--div class="qrWrapper">
                            <apex:outputText escape="false" value="{!dmsUserInfo.UPI_QR_CODE__c}" />
                        </div-->
                    </td>
    
                </tr>
    
                <!-- ROW 2 : 15% FOOTER -->
                <tr style="height:10%;">
                    <td colspan="3" style="padding-top:5px;">
                        <table width="100%">
                            <tr>
                                <td style="text-align:left; font-weight:bold;">
                                    GST No: {!sellerGstin}
                                </td>
    
                                <td style="text-align:right; font-weight:bold;">
                                    Mobile No: {!$Label.Hangyo_Phone}
                                </td>
                            </tr>
                        </table>   
                    </td>
                </tr>    
            </table>
    
        </div>
    </div>
    
    <!-- FOOTER -->
    <div id="footer">
    <div class="page-number"></div>
    </div>
    
    <!-- ================= INVOICE LOOP ================= -->
    <div class="invoiceBody">
    <apex:repeat value="{!invoiceWrappers}" var="wrapper">
    
    <table class="maintable">
    
    <!-- ================= ROW 2 (3 COLUMN) ================= -->
    <tr>
    
    <!-- BUYER -->
    <td colspan="10" valign="top" style="font-family:Tahoma;">    
        <b>Buyer Name:</b>
        <apex:outputText rendered="{!NOT(ISNULL(wrapper.invoice.Distributor_Account__r))}">
        <b>{!wrapper.invoice.Distributor_Account__r.Name} , </b>
        <div style="word-wrap: break-word; white-space: normal; width:250px;">
            <b>{!wrapper.invoice.Distributor_Account__r.BillingStreet},
            {!wrapper.invoice.Distributor_Account__r.BillingCity},
            {!wrapper.invoice.Distributor_Account__r.BillingState}</b>
        </div>
        </apex:outputText>
        
        <b>Ph No:</b>
        <apex:outputText rendered="{!NOT(ISNULL(wrapper.invoice.Distributor_Account__r))}">
            <b>{!wrapper.invoice.Order__r.Ordered_By__r.MobilePhone}</b>
        </apex:outputText><br/>   
    </td>
    
    <!-- BEAT / SALESMAN -->
    <td colspan="6" valign="top" style="font-family:Tahoma;">
        GST No:
        <apex:outputText rendered="{!NOT(ISNULL(wrapper.invoice.Distributor_Account__r))}">
            {!wrapper.invoice.Distributor_Account__r.GSTIN__c}
        </apex:outputText> <br/>
        Invoice No: {!wrapper.invoice.Name}<br/>
        Invoice Date:
            <apex:outputText value="{0,date,dd-MM-yyyy}">
                <apex:param value="{!wrapper.invoice.Invoice_Date__c}"/>
            </apex:outputText>   
    </td>
    
    <!-- INVOICE INFO -->
    <td colspan="4" valign="top" style="font-family:Tahoma;">   
        FSSAI No: {!$Label.Hangyo_FSSAI}
        <!--apex:outputText rendered="{!NOT(ISNULL(wrapper.invoice.Distributor_Account__r))}">
            {!wrapper.invoice.Distributor_Account__r.FSSAI__c}
        </apex:outputText-->
        <br/>
        
        E-Way Bill No: <br/>
        
        Credit Period: {!wrapper.invoice.Credit_Period__c}    
    </td>
    
    </tr>
    
    <!-- ================= HEADER ROW ================= -->
    <tr class="headerRow" align="center" style="font-family:Tahoma;">
        <th colspan="11">Item Description</th>
        <th>QTY</th>
        <th>MRP</th>
        <th>HSN</th>
        <th>Rate</th>
        <th>Basic Amt</th>
        <th>Disc</th>
        <th>Txble Amt</th>
        <th>Tax Amt</th>
        <th>Net Amt</th>
    </tr>
    
    <!-- ================= ITEMS ================= -->
    <apex:variable var="totalAmount" value="{!0}"/>
    <apex:variable var="i" value="{!0}"/>
    
    <apex:repeat value="{!wrapper.invoiceLineItems}" var="item">
    
    <apex:variable var="i" value="{!i+1}"/>
    <apex:variable var="totalAmount" value="{!totalAmount + item.Total_Amount__c}"/>
    <apex:variable var="linetotalAmount" value="{!item.Tax__c+item.CGST_Amount__c+item.SGST_Amount__c+item.IGST_Amount__c}"/>
    
    <tr>
        <td colspan="11">{!i}. {!item.Product__r.Name}</td>
        <td align="right">{!item.Quantity__c}</td>
        <td align="right"><apex:outputText value="{0,number,##0}"><apex:param value="{!item.MRP__c}" /></apex:outputText></td>
        <td align="right">{!$Label.Invoice_HSN}</td>
        <!--td align="right">{!item.Price__c}</td-->
        <td align="right">
            <apex:outputText value="{0, number, 0.00}">
                <apex:param value="{!item.Price__c}"/>
            </apex:outputText>
        </td>
        <td align="right">{!item.Total_Amount__c}</td>
        <td align="right">{!item.Total_Discount__c}</td>
        <td align="right">{!item.Amount_Excl_Tax__c}</td>
        <td align="right">{!item.Total_Tax__c}</td>
        <td align="right">{!item.Total_Amount_Incl_Tax__c}</td>
    </tr>
    
    </apex:repeat>
    
    <!-- ================= TOTAL ================= -->
    <tr class="totalRow" align="center">
        <td colspan="11" align="left">Total</td>
        <td>{!wrapper.invoice.Total_Quantity__c}</td>
        <td></td>
        <td></td>
        <td></td>
        <td>{!totalAmount}</td>
        <td>{!wrapper.invoice.Total_Discount_2__c}</td>
        <td>{!wrapper.invoice.Sub_Total__c}</td>
        <td>{!wrapper.invoice.Taxable_Amount__c}</td>
        <td>{!wrapper.invoice.Invoice_Amount__c}</td>
    </tr>
        
    <!-- ================= AMOUNT + SUMMARY SECTION ================= -->
    <tr>
    
        <!-- LEFT SIDE : AMOUNT + BANK DETAILS -->
        <td colspan="16" valign="top" style="border:1px solid black; padding:6px;">
    
            <b>Amount: {!wrapper.invoice.Invoice_Amount_In_Words__c}</b><br/><br/>
    
            <b>Invoice Amount Subject to Reverse Charge: NIL</b>
            <br/><br/>
    
            <b>Payment Against Delivery:</b><br/>
            <b>(Cash/QR Scan/NEFT – Refer Bank Details Below.)</b><br/><br/>
    
            <b>Account Name:</b> {!$Label.Name}<br/>
            <b>Bank Name:</b> {!$Label.Bank_Name}<br/>
            <b>Bank A/c No:</b> {!$Label.Bank_A_C_Number}<br/>
            <b>IFSC Code:</b> {!$Label.IFSC_code}
    
        </td>
    
        <!-- RIGHT SIDE : SUMMARY BOX -->
        <td colspan="4" valign="top" style="padding:-2px;">
    
            <table width="100%" style="border-collapse:collapse;">
    
                <tr>
                    <td style="border:1px solid black; font-weight:bold;">Sub Total</td>
                    <td style="border:1px solid black; text-align:right; font-weight:bold;">
                        {!totalAmount}
                    </td>
                </tr>
    
                <tr>
                    <td style="border:1px solid black; font-weight:bold;">Discount %</td>
                    <td style="border:1px solid black; text-align:right; font-weight:bold;">
                        <apex:outputText value="{0,number,##0.00}">
                            <apex:param value="{!discountPercent}" />
                        </apex:outputText>
                    </td>
                </tr>
    
                <tr>
                    <td style="border:1px solid black; font-weight:bold;">Discount Value</td>
                    <td style="border:1px solid black; text-align:right; font-weight:bold;">
                        {!wrapper.invoice.Total_Discount__c}
                    </td>
                </tr>
    
                <tr>
                    <td style="border:1px solid black; font-weight:bold;">Sch. Discount</td>
                    <td style="border:1px solid black; text-align:right; font-weight:bold;">
                        {!wrapper.invoice.Total_Discount_2__c}
                    </td>
                </tr>
    
                <tr>
                    <td style="border:1px solid black; font-weight:bold;">Taxable Value</td>
                    <td style="border:1px solid black; text-align:right; font-weight:bold;">
                        {!wrapper.invoice.Sub_Total__c}
                    </td>
                </tr>
    
                <tr>
                    <td style="border:1px solid black; font-weight:bold;">Total GST</td>
                    <td style="border:1px solid black; text-align:right; font-weight:bold;">
                        {!wrapper.invoice.Taxable_Amount__c}
                    </td>
                </tr>
    
                <tr>
                    <td style="border:1px solid black; font-weight:bold;">Round Off</td>
                    <td style="border:1px solid black; text-align:right; font-weight:bold;">
                        <apex:outputText value="{0,number,##0.00}">
                            <apex:param value="{!roundOff}" />
                        </apex:outputText>
                    </td>
                </tr>
    
                <tr>
                    <td style="border:1px solid black; font-weight:bold;">Net Amount</td>
                    <td style="border:1px solid black; text-align:right; font-weight:bold;">
                        {!wrapper.invoice.Invoice_Amount__c}
                    </td>
                </tr>
    
            </table>
    
        </td>
    </tr>
    
    <!-- ================= HSN SUMMARY ================= -->
    <tr>   
        <td colspan="12" valign="top" style="padding:0px;">
    
            <table width="100%" style="border-collapse:collapse;">
    
                <tr style="background:#d9d9d9; font-weight:bold;">
                    <td colspan="2" align="center" style="border:1px solid black;">HSN Code</td>
                    <td colspan="2" align="center" style="border:1px solid black;">Taxable Value</td>
                    <td colspan="2" align="center" style="border:1px solid black;">SGST %</td>
                    <td colspan="2" align="center" style="border:1px solid black;">SGST Amt</td>
                    <td colspan="2" align="center" style="border:1px solid black;">CGST %</td>
                    <td colspan="2" align="center" style="border:1px solid black;">CGST Amt</td>
                </tr>
    
                <tr>
                    <td colspan="2" align="center" style="border:1px solid black;">{!$Label.Invoice_HSN}</td>
                    <td colspan="2" align="center" style="border:1px solid black;">
                        {!wrapper.invoice.Taxable_Amount__c}
                    </td>
                    <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.SGST__c}</td>
                    <td colspan="2" align="center" style="border:1px solid black;">
                        {!wrapper.invoice.SGST_Amount__c}
                    </td>
                    <td colspan="2" align="center" style="border:1px solid black;">{!wrapper.invoice.CGST__c}</td>
                    <td colspan="2" align="center" style="border:1px solid black;">
                        {!wrapper.invoice.CGST_Amount__c}
                    </td>
                </tr>
    
                <tr style="font-weight:bold;">
                    <td colspan="2" align="center" style="border:1px solid black;">Total</td>
                    <td colspan="2" align="center" style="border:1px solid black;">
                        {!wrapper.invoice.Taxable_Amount__c}
                    </td>
                    <td colspan="4" align="center" style="border:1px solid black;">
                        {!wrapper.invoice.SGST_Amount__c}
                    </td>
                    <td colspan="4" align="center" style="border:1px solid black;">
                        {!wrapper.invoice.CGST_Amount__c}
                    </td>
                </tr>
    
            </table>
    
        </td>
        <td colspan="10" style="border:1px solid black;"></td>
    </tr>
    
    <!-- ================= TERMS ================= -->
        <tr>
            <td colspan="10">      
                <div class="termsTitle">Terms and Conditions</div>
                {!dmsUserInfo.Terms_and_Conditions__c}        
            </td>
            
            <td colspan="10" align="center">       
                <div class="sign">
                    For {!companyName}
                </div>
                
                <div class="signNote">
                    This is a computer generated invoice hence signature is not required
                </div>       
            </td>
        </tr>
    
    </table>
    
    </apex:repeat>
    </div>
    </body>
    </html>
</apex:page>