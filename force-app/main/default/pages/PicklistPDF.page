<apex:page renderAs="pdf" controller="PicklistPDFController" showHeader="false" applyBodyTag="false" action="{!setContentDispositionpdf}">
    <style>
        /* General Styling */
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
            color: #333;
        }

        h1 {
            text-align: center;
            color: #C1206B;
            font-size: 28px;
            margin-bottom: 30px;
            padding: 10px;
            border-bottom: 2px solid #C1206B;
            align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;  /* Ensures borders collapse into one line */
            margin-top: 30px;
            table-layout: fixed; /* Ensures uniform column widths */
        }

        th, td {
            border: 1px solid #C0C0C0;  /* Light gray border */
            padding: 15px;
            text-align: left;
            word-wrap: break-word;
        }

        th {
            background-color: #F5F5F5;
            color: #333;
            font-weight: bold;
            text-transform: uppercase;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        tr:hover {
            background-color: #f1f1f1;
        }

        .footer {
            text-align: right;
            margin-top: 30px;
            font-size: 12px;
            color: #777;
        }

        /* Styling for specific columns */
        .column-product {
            width: 40%; /* Product name column */
        }

        .column-quantity, .column-price, .column-amount, .column-uom {
            width: 15%; /* Uniform column width for Quantity, UOM, Price, and Amount */
            text-align: right; /* Align numerical columns to the right */
        }
         .user-info {
            display: grid;
            grid-template-columns: 1fr 1fr; /* Create two equal columns */
            gap: 20px;
            margin-top: 20px;
        }

        .user-info > div {
            box-sizing: border-box; /* Ensures padding and borders are included in width calculation */
        }

        .user-info label {
            font-weight: bold;
            margin-right: 10px;
        }

        .user-info span {
            word-wrap: break-word;
        }

        /* Equal Spacing for Table Header */
        th {
            padding: 15px 10px;
        }

        /* Increase spacing between rows for better readability */
        tr {
            height: 50px; /* Adds height to rows */
        }

        /* Responsive adjustments */
        @media print {
            h1 {
                font-size: 24px;
                align: center;
            }

            table {
                font-size: 12px;
            }

            th, td {
                padding: 10px;
            }
        }
    </style>

    <body>
        <!-- PDF Header -->
        <center> <h2 style="color: #c2185b; font-size: 16px; margin-bottom: 10px;">Picklist </h2> </center>
        <h3 style="color: #c2185b; font-size: 14px; margin-bottom: 10px;">Customer</h3>
       <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
            <tr>
                <td style="border: 1px solid #f8d7da; padding: 8px;">Distributor Name:</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">{!loggedInContact.Account.Name}</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">Driver Name:</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">{!deliveryPlans[0].Driver_Name__c}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #f8d7da; padding: 8px;">Mobile:</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">{!loggedInContact.Account.Owners_Number__c}</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">Driver Phone:</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">{!deliveryPlans[0].Driver_Number__c}</td>
            </tr>
            <tr>
                <td style="border: 1px solid #f8d7da; padding: 8px;">Distributor Address:</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">{!loggedInContact.Account.ShippingStreet} 
                              {!loggedInContact.Account.ShippingCity} 
                              {!loggedInContact.Account.ShippingState} 
                              {!loggedInContact.Account.ShippingPostalCode} 
                              {!loggedInContact.Account.ShippingCountry}</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">Vehicle Number:</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">{!deliveryPlans[0].Vehicle_Number__c}</td>
            </tr>
            <tr>
             
                <td style="border: 1px solid #f8d7da; padding: 8px;">Date</td>
                <td style="border: 1px solid #f8d7da; padding: 8px;">{!formattedDate}</td>
                <td ></td>
                <td ></td>
            </tr>
        </table><br/><br/>
        
        <h3 style="color: #c2185b; font-size: 14px; margin-bottom: 10px;">Product Details</h3>
        <!-- Table -->
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
            <thead>
                <tr >
                    <th style="border: 1px solid #f8d7da; padding: 9px; background-color: #E5E4E2; text-align: left;">Particulars</th>
                    <th style="border: 1px solid #f8d7da; padding: 9px; background-color: #E5E4E2; text-align: left;">UOM</th>
                    <th style="border: 1px solid #f8d7da; padding: 9px; background-color: #E5E4E2; text-align: left;">Crate</th>
                    <th style="border: 1px solid #f8d7da; padding: 9px; background-color: #E5E4E2; text-align: left;">Quantity</th>
                    <th style="border: 1px solid #f8d7da; padding: 9px; background-color: #E5E4E2; text-align: left;">Price</th>
                    <th style="border: 1px solid #f8d7da; padding: 9px; background-color: #E5E4E2; text-align: left;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <!-- Loop through picklist records -->
                <apex:repeat value="{!picklistRecords}" var="item">
                    <tr>
                        <td style="border: 1px solid #f8d7da; padding: 8px;">{!item.Product__r.Name}</td>
                        <td style="border: 1px solid #f8d7da; padding: 8px;">{!item.UOM__c}</td>
                        <td style="border: 1px solid #f8d7da; padding: 8px;">{!item.Crate__c}</td>
                        <td style="border: 1px solid #f8d7da; padding: 8px;">{!item.Quantity__c}</td>
                        <td style="border: 1px solid #f8d7da; padding: 8px;">{!item.Unit_Price__c}</td>
 <td style="border: 1px solid #f8d7da; padding: 8px;">
            <apex:outputText value="{0,number,#,##0.00}">
                <apex:param value="{!item.Gross_Amount__c}" />
            </apex:outputText>
        </td>
                    </tr>
                </apex:repeat>
            </tbody>
        </table><br/><br/>

        
    </body>
</apex:page>