<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Copy_Hub_And_Location</name>
        <label>Copy Hub And Location</label>
        <locationX>176</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>$Record.Retailer_Hub__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Retailer.Hub__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Retailer_Location__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Retailer.Location_Text__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Retailer_Hub_Match__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Retailer.Hub__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_Return_Case</name>
        <label>Is Return Case</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Return_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Type.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Branding &amp; Marketing Asset transfer Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Retailer</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Branding Return Case: stamps the retailer&apos;s hub and location onto the case so Mahesh sees them on the approval page and the Vendor lookup filter can match vendors in the same hub. Before-save, so no extra DML. The case type is fetched rather than read from the Case_Type_Name__c formula, because a before-save flow cannot traverse the lookup.</description>
    <environments>Default</environments>
    <interviewLabel>Case Copy Retailer Hub Location {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Copy Retailer Hub Location</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Case_Type</name>
        <label>Get Case Type</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Return_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Case_Type__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case_Type__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Retailer</name>
        <label>Get Retailer</label>
        <locationX>176</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Copy_Hub_And_Location</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Retailer__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Hub__c</queriedFields>
        <queriedFields>Location_Text__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Case_Type</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.Case_Type__c})),
  NOT(ISBLANK({!$Record.Retailer__c}))
)</filterFormula>
        <object>Case__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
