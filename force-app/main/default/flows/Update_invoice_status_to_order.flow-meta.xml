                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_related_order_to_confirmed</targetReference>
            </connector>
            <label>Invoice status is confirmed</label>
        </rules>
        <rules>
            <name>Invoice_status_is_delivered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delivered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_related_order_to_delivered</targetReference>
            </connector>
            <label>Invoice status is delivered</label>
        </rules>
    </decisions>
