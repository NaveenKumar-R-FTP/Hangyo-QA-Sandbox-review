            <value>
                <stringValue>Sale to Under S</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Copy_3_of_Update_the_Invoice_Record</name>
        <label>Update the Invoice Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Transaction_Type_Sale__c</field>
            <value>
                <stringValue>Sale to Retailer</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
