    <description>Mahesh&apos;s approval path for a New Branding Request. Collects the Vendor only - filtered to the outlet&apos;s hub - then approves his pending step via ApproveReturnCaseAction. No Branding Return Status is sent: that field belongs to the transfer/return type. The standard Approve button is blocked by CaseTriggerHandler so everything funnels through here.</description>
    <dynamicChoiceSets>
        <name>Vendors_For_Hub</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Hub__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case.Retailer_Hub__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Active__c</field>
