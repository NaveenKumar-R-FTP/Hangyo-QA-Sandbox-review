<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>if transfer request and retailer or distributor selected then add the asset to them</description>
        <name>Check_recordtype</name>
        <label>Check recordtype</label>
        <locationX>776</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Transfer_request</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Transfer_Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Approval_Request_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Request approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Approval_Request_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decide_on_transfer_to_whom</targetReference>
            </connector>
            <label>Transfer request</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decide_on_transfer_to_whom</name>
        <label>Decide on transfer to whom</label>
        <locationX>446</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>retailer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type_of_request__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Transfer to other outlet</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Transfer_retailer__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>update_asset</targetReference>
            </connector>
            <label>retailer</label>
        </rules>
        <rules>
            <name>distributor</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type_of_request__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Transfer to other distributor</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Transfer_Distributor__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <connector>
                <targetReference>update_distributor_asset</targetReference>
            </connector>
            <label>distributor</label>
        </rules>
        <rules>
            <name>pull_out_to_DB</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type_of_request__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Pull out to DB</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Transfer_retailer__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Transfer_Distributor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_update_asset</targetReference>
            </connector>
            <label>pull out to DB</label>
        </rules>
    </decisions>
    <description>implemented for retailer and distributor only</description>
    <environments>Default</environments>
    <interviewLabel>Flow to complete the transfer on approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flow to complete the transfer on approval</label>
