        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Type_DD</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_The_PriceBook_Entries_Records.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Direct Distributor</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Inventory_Record</targetReference>
            </connector>
            <label>If Type = DD</label>
        </rules>
        <rules>
            <name>If_Type_SS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_The_PriceBook_Entries_Records.Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Super Stockist</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Update_the_Inventory_Record</targetReference>
            </connector>
            <label>If Type = SS</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Type_Formula</name>
        <dataType>String</dataType>
        <expression>IF(
    {!$Record.Distributor_Name__r.Record_type_Name__c} = &quot;Super Stockist&quot;,
    {!$Record.Distributor_Name__r.Record_type_Name__c},
  &apos;Direct Distributor&apos;
