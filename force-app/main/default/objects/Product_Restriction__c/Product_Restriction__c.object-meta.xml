    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Deny list: a row here means every Distributor Account in the specified Hub should NOT see the specified Product in any product listing/ordering screen (Counter, Secondary, Primary, Under-SS, Portal). Restrictions are keyed by Hub (Account.Hub__c), not by an individual Distributor, so one row denies a product for every distributor in that Hub at once. Distributors whose Hub has no matching row see the full catalog as normal — this only ever removes products, it never grants extra access.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Product Restriction</label>
    <nameField>
        <displayFormat>PR-{0000}</displayFormat>
        <label>Restriction Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Product Restrictions</pluralLabel>
    <searchLayouts></searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
