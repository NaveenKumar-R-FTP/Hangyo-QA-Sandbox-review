<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Product_required_for_Entity_Type_Product</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Entity_Type__c, &apos;Product&apos;),
    OR(ISBLANK(Product__c), NOT(ISBLANK(Product_Brand__c)))
  )</errorConditionFormula>
    <errorMessage>Entity Type is Product — select a Product and leave Product Brand blank.</errorMessage>
</ValidationRule>
