<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Max_Limit_Message__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
    AND(
        ISPICKVAL(User_Role__c, &quot;SO&quot;),
        ISPICKVAL(Expense_Type__c, &quot;Travel Expense&quot;),
        ISPICKVAL(Transport_Type__c, &quot;Bus&quot;)
    ),
    &quot;The maximum limit for this combination is Rs 1500.&quot;,
    &quot;&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Max limit is 1500</inlineHelpText>
    <label>Max Limit Message</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
