<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Request_Photo__c</fullName>
    <description>Renders the photo captured when the case was raised, so approvers can see it on the approval page.</description>
    <externalId>false</externalId>
    <formula>IF( Request_Image_URL__c != null ,(IMAGE(Request_Image_URL__c , &apos;Request Photo&apos;, 200, 200)) ,&apos;&apos; )</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Request Photo</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
