<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Change_After_Completed</fullName>
    <active>true</active>
    <errorConditionFormula>AND( NOT( ISNEW() ), ISPICKVAL( PRIORVALUE(Status__c), &quot;Completed&quot; ) )</errorConditionFormula>
    <errorMessage>This activity is already saved and cannot be changed.</errorMessage>
</ValidationRule>
