<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Time_Required_To_Complete</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL(Status__c, &quot;Completed&quot;), ISBLANK(End_Time__c) )</errorConditionFormula>
    <errorMessage>End the activity before saving it.</errorMessage>
</ValidationRule>
