<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Case_Type__c</field>
        <field>Distributor__c</field>
        <field>Retailer__c</field>
        <field>Media_Lines_Summary__c</field>
        <field>Remarks__c</field>
        <field>Request_Photo__c</field>
        <field>Duplicate_Warning__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>L1_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>L1_Approved_Date</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>L1__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>L1 Approved</label>
        <name>L1_Approved</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>L2__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Case__c.L1__c</field>
                <operation>notEqual</operation>
                <value>005fu00000DKEDpAAP</value>
            </criteriaItems>
        </entryCriteria>
        <label>L2 Approved</label>
        <name>L2_Approved</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Branding &amp; Marketing Asset Inventory Management. Two levels: L1 from the submitter&apos;s chain (ASM/RSM), then Mahesh. Final approval sets Installed directly - there is no separate installation step because each media line already carries its own photo captured at request time. Reaching Installed creates the Branding Assets on the store.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <criteriaItems>
            <field>Case__c.Case_Type_Name__c</field>
            <operation>equals</operation>
            <value>Branding &amp; Marketing Asset Inventory Management</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Status__c</field>
            <operation>equals</operation>
            <value>Open</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Status__c</field>
            <operation>equals</operation>
            <value>Reject</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approve_Date_L1</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Installed</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejected2</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Pending2</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Branding Marketing Inventory Approval</label>
    <processOrder>5</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
