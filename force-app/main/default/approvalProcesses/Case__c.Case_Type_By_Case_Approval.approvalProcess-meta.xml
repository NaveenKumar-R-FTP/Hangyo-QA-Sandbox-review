<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Case_Type__c</field>
        <field>Distributor__c</field>
        <field>Warehouse__c</field>
        <field>Retailer__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Approve L1</label>
        <name>Approve_L1</name>
    </approvalStep>
    <description>Asset Transfer Request,
Existing outlet Asset Code Change Request</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>(1 OR 4 OR 5 ) AND (2 OR 3)</booleanFilter>
        <criteriaItems>
            <field>Case__c.Case_Type_Name__c</field>
            <operation>equals</operation>
            <value>Existing outlet Asset Code Change Request</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Status__c</field>
            <operation>equals</operation>
            <value>Open</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Status__c</field>
            <operation>equals</operation>
            <value>Reject</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Case_Type_Name__c</field>
            <operation>equals</operation>
            <value>Asset Transfer Request</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Case_Type_Name__c</field>
            <operation>equals</operation>
            <value>Asset Tagging Request</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>L1_Approved_Date2</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_Sync_True_v1</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Case Type By Case Approval</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>L1_Approver__c</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
